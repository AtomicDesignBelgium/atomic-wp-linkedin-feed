{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "atomic-wp-social-sync/feed",
  "version": "0.10.0",
  "title": "Atomic LinkedIn Posts",
  "category": "widgets",
  "icon": "share",
  "description": "Display a local feed of LinkedIn posts managed via official embeds.",
  "textdomain": "atomic-wp-social-sync",
  "attributes": {
    "postsPerPage": { "type": "number", "default": 8 },
    "order": { "type": "string", "default": "newest" },
    "pinnedFirst": { "type": "boolean", "default": true },
    "homepageOnly": { "type": "boolean", "default": false },
    "providers": { "type": "array", "default": ["linkedin"] },
    "connections": { "type": "array", "default": [] },
    "desktopColumns": { "type": "number", "default": 3 },
    "tabletColumns": { "type": "number", "default": 2 },
    "mobileColumns": { "type": "number", "default": 1 },
    "gap": { "type": "string", "default": "medium" },
    "showImage": { "type": "boolean", "default": true },
    "imageRatio": { "type": "string", "default": "auto" },
    "showPostTitles": { "type": "boolean", "default": true },
    "showDate": { "type": "boolean", "default": true },
    "showExcerpt": { "type": "boolean", "default": true },
    "excerptLength": { "type": "number", "default": 30 },
    "showSource": { "type": "boolean", "default": true },
    "showCta": { "type": "boolean", "default": true },
    "ctaLabel": { "type": "string", "default": "View post" },
    "cardLink": { "type": "string", "default": "original" },
    "pagination": { "type": "string", "default": "none" },
    "presentation": { "type": "string", "default": "compact" },
    "layout": { "type": "string", "default": "grid" },
    "minWidth": { "type": "number", "default": 340 },
    "carouselHeight": { "type": "number", "default": 640 },
    "stackedWidth": { "type": "string", "default": "native" },
    "stackHeightStrategy": { "type": "string", "default": "estimated" },
    "showSeparator": { "type": "boolean", "default": false },
    "separatorThickness": { "type": "number", "default": 1 },
    "separatorColor": { "type": "string", "default": "#dcdcde" },
    "separatorSpacing": { "type": "number", "default": 40 },
    "overrideStyles": { "type": "boolean", "default": false },
    "borderStyle": { "type": "string", "default": "global" },
    "borderWidth": { "type": "number", "default": 1 },
    "borderColor": { "type": "string", "default": "" },
    "showFullNewsCta": { "type": "boolean", "default": false },
    "fullNewsCtaLabel": { "type": "string", "default": "View all news" },
    "newsPageId": { "type": "number", "default": 0 },

    "postPreviewMode": { "type": "boolean", "default": false },
    "postPreviewHeight": { "type": "number", "default": 620 },
    "allowEmbedScrolling": { "type": "boolean", "default": true },

    "readFullNewsLinks": { "type": "boolean", "default": false },
    "showPostCta": { "type": "boolean", "default": false },
    "postCtaLabel": { "type": "string", "default": "Read full news" },

    "showNewsNavigation": { "type": "boolean", "default": false },
    "newsNavigationTitle": { "type": "string", "default": "Latest news" },
    "newsNavigationPosition": { "type": "string", "default": "left" },
    "stickyNewsNavigation": { "type": "boolean", "default": true },
    "highlightCurrentPost": { "type": "boolean", "default": true }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "atomic-wp-social-sync-frontend",
  "viewScript": "atomic-wp-social-sync-load-more"
}
